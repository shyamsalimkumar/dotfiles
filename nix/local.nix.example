# Local configuration (gitignored)
# Copy this file to ~/.config/nix-darwin/local.nix and customize
# This file is loaded by work-profiles.nix to enable/disable work profiles

{
  profiles = {
    # Enable/disable company profiles
    # Set to true to load company-specific packages and configurations
    # After changing, run: darwin-rebuild switch --flake ~/.config/nix-darwin#mac

    companyA.enable = false;  # Change to true to enable Company A profile
    companyB.enable = false;  # Change to true to enable Company B profile
  };
}
