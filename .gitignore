### Vim/NeoVim ###
# LazyVim's own bookkeeping (extras toggled via :LazyExtras, version/news markers) — local machine state, not config
nvim/.config/nvim/lazyvim.json

### Helpers ###
helpers/work/*
!helpers/work/.gitkeep

### Zsh ###
zsh/aliases.work

### Homebrew ###
Brewfile*.lock.json

### Claude Code ###
claude/settings.local.json

# Skills imported locally via `npx skills add` (see README "Manual step") land
# as symlinks in claude/skills/ — don't track them; re-run the command to
# recreate them on a fresh machine. .gitignore has no symlink-type matcher,
# so add each new one's name here.
claude/skills/skill-creator
claude/skills/web-design-guidelines
claude/skills/writing-guidelines
claude/skills/lavish

# Dropped by no-mistakes's own installer (see scripts/setup-ai-tools.sh) —
# regenerated by that install step, so don't track it here either.
claude/skills/no-mistakes

### Nix Darwin ###
# Local configuration (machine-specific work profile settings)
nix/local.nix

# Nix build results
result
result-*
