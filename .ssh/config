# Generic SSH configuration - host aliases and default settings
# This file is version-controlled and should only contain generic configuration
# For host-specific settings (hostnames, usernames, key paths), use ~/.ssh/config.local (not tracked)

# ssh_config uses first-match-wins, so include local settings first so they can
# override or add to the generic aliases below. scripts/post-install.sh creates
# this file if it doesn't exist yet.
Include ~/.ssh/config.local

#Github.com
Host github
    HostName github.com
    User git
    IdentityFile ~/.ssh/github
    IdentitiesOnly=yes

#Bitbucket.org
Host bitbucket
    HostName bitbucket.com
    User git
    IdentityFile ~/.ssh/bitbucket
    IdentitiesOnly=yes

#Openshift.com
Host openshift
    HostName rhcloud.com
    User git
    IdentityFile ~/.ssh/openshift
    IdentitiesOnly=yes

#Heroku.com
Host heroku
    HostName heroku.com
    User git
    IdentityFile ~/.ssh/heroku
    IdentitiesOnly=yes
