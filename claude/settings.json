{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Edit(~/Projects/github.com/shyamsalimkumar/*/worktrees/**)"
    ],
    "deny": [],
    "ask": [],
    "defaultMode": "auto"
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "mattpocock-skills@mattpocock": true,
    "typescript-lsp@claude-plugins-official": true,
    "andrej-karpathy-skills@karpathy-skills": true
  },
  "outputStyle": "ELI5",
  "alwaysThinkingEnabled": true,
  "disableClaudeAiConnectors": true,
  "extraKnownMarketplaces": {
    "mattpocock": {
      "source": {
        "source": "github",
        "repo": "mattpocock/skills"
      },
      "autoUpdate": true
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "autoMode": {
    "allow": [
      "$defaults",
      "Editing, creating or deleting files inside a worktrees/ folder under ~/Projects/github.com/shyamsalimkumar/ (these are temporary agent working copies on their own branch, never a main checkout)"
    ]
  }
}
