# Personal utility functions

# Auto-load .nvmrc if present
load-nvmrc() {
  local node_version="$(nvm version)"
  local nvmrc_path="$(nvm_find_nvmrc)"

  if [ -n "$nvmrc_path" ]; then
    local nvmrc_node_version=$(nvm version "$(cat "${nvmrc_path}")")

    if [ "$nvmrc_node_version" = "N/A" ]; then
      nvm install
    elif [ "$nvmrc_node_version" != "$node_version" ]; then
      nvm use
    fi
  elif [ "$node_version" != "$(nvm version default)" ]; then
    nvm use default
  fi
}

# Helper function for sorting JSON
sort_json() {
  jq -S '.' "$1"
}

# Start Colima the first time docker is used, so it doesn't sit on 8 GB of
# memory all day. The socket only exists while Colima is running.
if (( $+commands[colima] )); then
  _colima_up() {
    [[ -S "$HOME/.colima/default/docker.sock" ]] || colima start --cpus 4 --memory 8
  }
  docker() { _colima_up && command docker "$@"; }
  docker-compose() { _colima_up && command docker-compose "$@"; }
  kind() { _colima_up && command kind "$@"; }
fi
